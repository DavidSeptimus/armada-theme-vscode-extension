{
  "name": "armada-theme",
  "displayName": "Armada Theme",
  "description": "A dark color theme inspired by the dark themes of JetBrains Fleet and Air, optimized for VS Code's modern UI.",
  "version": "2.2.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "scripts": {
    "build:theme": "node --experimental-strip-types scripts/build-theme.mjs"
  },
  "categories": [
    "Themes"
  ],
  "publisher": "DavidSeptimus",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidSeptimus/armada-theme-vscode-extension.git"
  },
  "license": "MIT",
  "contributes": {
    "themes": [
      {
        "label": "Armada",
        "uiTheme": "vs-dark",
        "path": "./themes/Armada-color-theme.json"
      }
    ]
  },
  "keywords": [
    "theme",
    "color theme",
    "dark theme",
    "jetbrains",
    "fleet",
    "armada",
    "air",
    "islands",
    "modern ui"
  ]
}
